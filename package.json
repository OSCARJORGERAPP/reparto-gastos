{
  "name": "reparto-gastos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "db:verify": "tsx scripts/verify-mongodb.ts",
    "db:logs": "docker-compose logs -f mongodb",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mongodb": "^6.3.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  }
}
